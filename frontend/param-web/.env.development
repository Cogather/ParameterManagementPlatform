# 本地开发（npm run dev，--mode development）
VITE_DEV_PORT=8080
VITE_PROXY_TARGET=http://127.0.0.1:8081

# 参数服务：相对路径走 Vite /api 代理
VITE_API_BASE_URL=/api/v1

# 配置中心：相对 /config 走 Vite 代理（目标见 VITE_CONFIG_PROXY_TARGET）；不配代理时可改为完整测试 URL
VITE_CONFIG_API_BASE_URL=/config
VITE_CONFIG_PROXY_TARGET=https://config-test.example.com
